# ==============================================================================
# AgriGuard Backend Environment Variables
# ==============================================================================

PROJECT_NAME=AgriGuard
API_V1_STR=/api/v1
ENVIRONMENT=development
DEBUG=True

# --- Relational Database (SQLite for immediate local dev / PostgreSQL for prod) ---
# SQLite default:
DATABASE_URL=sqlite:///./agriguard.db
# PostgreSQL example:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agriguard

# --- Neo4j Graph Database (Pest Knowledge Graph & Community Outbreak AI) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
# If true, uses an in-memory/mock graph traversal whenever the Neo4j instance is offline:
NEO4J_MOCK_FALLBACK=True

# --- Security & JWT Authentication ---
SECRET_KEY=agriguard-change-this-secret-key-for-production-min32bytes-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- AI Service Integration (Person 2's Model Service) ---
AI_SERVICE_URL=http://localhost:8001/api/v1/predict
AI_SERVICE_TIMEOUT_SECONDS=10
AI_SERVICE_MOCK_FALLBACK=True

# --- Notification & SMS Gateway (Africa's Talking / Mock) ---
SMS_PROVIDER=mock
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=your_api_key_here
SMS_SENDER_ID=AgriGuard

# --- File Storage ---
UPLOAD_DIR=app/static/uploads
MAX_IMAGE_SIZE_MB=10

# --- USSD & IVR Gateway Channels ---
# Shared secret authenticating the gateway caller (NOT JWT). Change in production.
USSD_IVR_GATEWAY_SECRET=agriguard-dev-ussd-ivr-secret-change-me
USSD_PROVIDER=africas_talking
IVR_PROVIDER=generic_voice
