# ── AgriGuard AI Service — Environment Configuration (Python/FastAPI) ──────────
# Copy this file to .env and adjust values as needed.
# The prototype runs fully in "mock" mode with NO API keys required.

# ── AI Mode ────────────────────────────────────────────────────────────────
# mock   = deterministic prototype (default, no external API needed)
# openai = use OpenAI GPT-4o for vision + GPT-4o-mini for text (requires key)
AI_MODE=mock

# ── OpenAI Configuration (only needed if AI_MODE=openai) ─────────────────────
# NEVER commit your real API key. Leave blank in mock mode.
OPENAI_API_KEY=
OPENAI_URL=https://api.openai.com/v1/chat/completions
OPENAI_VISION_MODEL=gpt-4o
OPENAI_TEXT_MODEL=gpt-4o-mini

# ── Confidence Thresholds (0.0–1.0) ────────────────────────────────────────
# >= high   = high confidence (AI can give initial recommendation)
# >= medium = medium confidence (ask for more info / another photo)
# <  medium = low confidence (do not pretend to know; escalate)
AI_CONFIDENCE_HIGH=0.80
AI_CONFIDENCE_MEDIUM=0.50

# ── Outbreak Detection ─────────────────────────────────────────────────────
# Minimum reports in a cluster to be considered a risk signal.
OUTBREAK_MIN_REPORTS=3
# Report counts that trigger HIGH / CRITICAL risk levels.
OUTBREAK_HIGH_RISK_REPORTS=7
OUTBREAK_CRITICAL_RISK_REPORTS=12
# Time window for "recent" reports (days).
OUTBREAK_TIME_WINDOW_DAYS=7
# Alert radius in kilometres for personalised farmer alerts.
ALERT_RADIUS_KM=5.0

# ── Server ─────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CORS_ORIGIN=*
