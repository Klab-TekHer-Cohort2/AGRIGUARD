# FloraGuard Backend Configuration
# Copy this file to .env and adjust values as needed.

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=False
API_WORKERS=1
ALLOWED_ORIGINS=*

# --- Weather (Open-Meteo, free, no key required) ---
WEATHER_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_TIMEOUT_SECONDS=5.0
WEATHER_CACHE_TTL_SECONDS=300

# --- AI Model Integration ---
# Leave empty to disable AI predictions. Member 1 should provide the model.
# Expected interface: predict_image(image_path) -> dict or None
AI_MODEL_PATH=
AI_TIMEOUT_SECONDS=10.0

# --- Risk Engine ---
RISK_WINDOW_HOURS=72
RISK_SCORE_LOW_MAX=29.0
RISK_SCORE_MEDIUM_MAX=59.0

# --- Alerts ---
AUTO_CREATE_ALERTS=True
ALERT_SCORE_THRESHOLD=60.0

# --- SMS Delivery (future integration) ---
# Do not commit real credentials.
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=

# --- Supported Areas (comma separated) ---
SUPPORTED_AREAS=Gishari Flower Park,Nyabugogo Flora Market,Rwamagana Sector

# --- Image Upload Validation ---
MAX_IMAGE_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp