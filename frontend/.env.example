# ============================================================
# AgriGuard Mobile Frontend — Environment Variables
# Copy to .env and edit for your setup.
# EXPO_PUBLIC_ prefix exposes variables to the client bundle.
# ============================================================

# Backend API base URL (Person 3's FastAPI backend)
EXPO_PUBLIC_BACKEND_URL=http://localhost:8000

# AI Service base URL (Person 2's AI FastAPI service)
# Used ONLY for the Ask AgriGuard chat feature.
EXPO_PUBLIC_AI_URL=http://localhost:5000
